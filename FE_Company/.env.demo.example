# Vite build-time env for FE_Company demo
# Copy to .env when running the Demo frontend. Do not commit secrets.

VITE_APP_ENV=demo
VITE_MAPBOX_TOKEN=
# Demo FE talks to Demo BE_Company directly (localhost:5401 via Vite /demo-api).
# Production sales-manager still uses the gateway + GetAdmin cityValue.

# BE_CustomerApp (تطبيق الزبون) — admin API. Default /customer-app/api/v1/ (proxied to 127.0.0.1:5380).
VITE_CUSTOMER_APP_API_URL=/customer-app/api/v1/
