# Vite build-time env for FE_Company production
# Copy to .env.production or set in the host. Do not commit secrets.

VITE_APP_ENV=production
VITE_MAPBOX_TOKEN=
VITE_SALES_GATEWAY_URL=/sales-gw/api/
# رابط الفيديو التعليمي لزر المحاسب الرئيسي (اختياري — أو عبّه في MobileAppTutorialLinks appKey=accountant)
VITE_ACCOUNTANT_TUTORIAL_VIDEO_URL=
# BE_CustomerApp (تطبيق الزبون) — admin API. Default /customer-app/api/v1/ (proxied to 127.0.0.1:5380).
VITE_CUSTOMER_APP_API_URL=/customer-app/api/v1/
